  "triggers": ["on_fuse"], "release_events": 1, "parent_action": "continue",
  "payloads": [{ "kind": "rvp_weapon", "weapon_id": "lav25_tow2b_efp", "count": 15,
    "launch_yaw": 0, "launch_pitch": 90, "launch_angle_mode": "absolute", "launch_speed": 1.0,
    "inherit_parent_velocity": false,
    "spread": { "mode": "canister", "canister_type": 1, "canister_diff": 40.0 } }]
}]}

// m142_m30：集束火箭，48 枚，继承母弹速度 45%，整体下坠
